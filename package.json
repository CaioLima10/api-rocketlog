  "description": "API de entregas de encomendas",
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch --env-file .env src/server.ts",
    "test:dev": "cross-env NODE_OPTIONS=--experimental-vm-modules npx jest --watch --runInBand",
